{
  "name": "readflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:web": "next dev",
    "dev:worker": "tsx src/worker/index.ts",
    "worker:remote": "tsx src/worker/remote.ts",
    "app:install": "bash scripts/app-service.sh install",
    "app:uninstall": "bash scripts/app-service.sh uninstall",
    "app:logs": "bash scripts/app-service.sh logs",
    "app:status": "bash scripts/app-service.sh status",
    "dev:all": "concurrently -k -n web,worker -c blue,magenta \"next dev\" \"tsx watch src/worker/index.ts\"",
    "dev:mcp": "tsx src/mcp/server.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "icons": "node scripts/build-icons.mjs",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore": "tsx scripts/db-restore.ts",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "dev:e2e": "node scripts/e2e-server.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "app:start": "concurrently -k -n web,worker -c blue,magenta \"next start -H 127.0.0.1\" \"tsx src/worker/index.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mozilla/readability": "^0.6.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "better-sqlite3": "^13.0.3",
    "docx": "^9.7.1",
    "jsdom": "^30.0.1",
    "mammoth": "^1.12.2",
    "next": "16.3.4",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.17.7",
    "unpdf": "^1.8.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": { "node": ">=22" }
}
