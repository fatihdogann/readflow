# --- Readflow ortam değişkenleri ---
# Bu dosyayı .env.local olarak kopyalayın. .env.local Git'e girmez.

# Yerel veri dizini (varsayılan: ~/.readflow)
READFLOW_DATA_DIR=

# Agent CLI bağlantısı.
# Boşsa worker bilinen CLI'ları (claude, codex, jcode) --help imzasıyla
# otomatik tespit etmeye çalışır. Manuel bağlamak için tam komutu yazın;
# prompt stdin'den verilir, sonuç stdout'tan okunur. Örnekler:
#   READFLOW_AGENT_CMD=claude -p
#   READFLOW_AGENT_CMD=codex exec -
#   READFLOW_AGENT_CMD="node scripts/mock-agent.mjs"
READFLOW_AGENT_CMD=

# auto | command | mock | none
READFLOW_AGENT_MODE=auto

# Agent çağrısı için zaman aşımı (ms)
READFLOW_AGENT_TIMEOUT_MS=120000

# Prompt'un agent'a verilme yolu: stdin (önerilen) veya argv (ör. jcode run)
READFLOW_AGENT_PROMPT_VIA=stdin

# Agent çalışma dizini (boşsa repo kökü)
READFLOW_AGENT_CWD=

# --- Notion entegrasyonu (opsiyonel) ---
READFLOW_NOTION_TOKEN=
READFLOW_NOTION_DATABASE_ID=
READFLOW_NOTION_TITLE_PROP=Name

# --- Telegram entegrasyonu (opsiyonel) ---
READFLOW_TELEGRAM_BOT_TOKEN=
READFLOW_TELEGRAM_CHAT_ID=

# --- Site girişi (tek kullanıcı) ---
# İkisi de tanımlıysa site kilitli olur; boş bırakılırsa yerelde açık çalışır.
READFLOW_AUTH_USERNAME=
READFLOW_AUTH_PASSWORD=
# Oturum imza anahtarı (production'da zorunlu, ≥32 karakter; geliştirmede paroladan türetilir)
READFLOW_SESSION_SECRET=

# --- OCR (taranmış PDF) ---
# Sistem tesseract + pdftoppm kuruluysa otomatik çalışır.
# READFLOW_OCR=off            # tamamen kapat
# READFLOW_OCR_LANG=tur+eng   # kurulu tesseract dilleri
# READFLOW_OCR_MAX_PAGES=50   # bir PDF'ten okunacak en fazla sayfa
